# PostgreSQL
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot_password
POSTGRES_DB=stockpilot_db

# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stockpilot:stockpilot_password@localhost:5432/stockpilot_db?schema=public
FRONTEND_URL=http://localhost:5173

# Email Delivery (console or smtp)
OTP_DELIVERY_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1
